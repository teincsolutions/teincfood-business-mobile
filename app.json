{
  "expo": {
    "name": "TeincFoodBusiness",
    "slug": "teinc-food-business",
    "owner": "teincsolutions",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "teincfoodbusiness",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF7622"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.teincfoods.business",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tel"
        ],
        "NSCameraUsageDescription": "$(PRODUCT_NAME) needs access to your camera to take profile pictures and upload documents.",
        "NSPhotoLibraryUsageDescription": "$(PRODUCT_NAME) needs access to your photos to upload profile pictures and documents.",
        "NSLocationWhenInUseUsageDescription": "$(PRODUCT_NAME) uses your location to manage deliveries and track your position.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "$(PRODUCT_NAME) uses your location to track deliveries in real-time and update your availability.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF7622",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.teincfoods.business",
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyKeyForTestingPurposesOnly123456789"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "com.google.android.gms.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withNotifeeRepo.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "$(PRODUCT_NAME) uses your location to manage deliveries and track your position.",
          "locationAlwaysAndWhenInUsePermission": "$(PRODUCT_NAME) uses your location to track deliveries in real-time and update your availability.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-live-activity"
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "$(PRODUCT_NAME) needs access to your photos to upload profile pictures and documents.",
          "cameraPermission": "$(PRODUCT_NAME) needs access to your camera to take profile pictures and upload documents."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF7622",
          "sounds": [
            "./assets/notification_sound.wav"
          ],
          "mode": "production"
        }
      ],
      [
        "expo-apple-authentication"
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "LiveActivity",
                  "bundleIdentifier": "com.teincfoods.business.LiveActivity",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "afa9b762-7069-493e-9a0d-de02c757e3bc"
      }
    }
  }
}
